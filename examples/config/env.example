# Example environment template — NON-SECRET
# Copy to .env, fill in YOUR values, keep the .env out of git.
# Every value below is a placeholder. Nothing here is a real credential,
# endpoint, or path.

# ── Model / auth ────────────────────────────────────────────────
# All seats resolve credentials from one shared auth source (ADR-0003).
# The variables below are illustrative only.
MODEL_PROVIDER=<PROVIDER>
MODEL_NAME=<MODEL_NAME>

# ── Optional overrides ──────────────────────────────────────────
# Global per-step timeout ceiling in seconds (see ADR-0004).
# SEAT_TIMEOUT=900

# ── Flags ───────────────────────────────────────────────────────
# VERBOSE=true
# DRY_RUN=false
